@host = https://localhost:7247

### user anlegen
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "userName": "TESTUSER",
  "userEmail": "testuser3@example.com",
  "password": "TestPassword123!"
}

### user anlegen
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "userName": "anna",
  "userEmail": "anna@example.com",
  "password": "TestPasswordAnna!"
}

### user einloggen
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "login": "testuser",
  "password": "TestPassword123!"
}

### user einloggen (anna)
# @name loginAnna
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "login": "anna",
  "password": "TestPasswordAnna!"
}

### user einloggen
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "login": "testuser",
  "password": ""
}

###
GET {{host}}/api/checklists/1/items/1
Authorization: Bearer {{login.response.body.$.token}}

###
GET {{host}}/api/checklists/1/items/1
Authorization: Bearer {{loginAnna.response.body.$.token}}

### verfaelschter Token (erwartet 401)
GET {{host}}/api/checklists
Authorization: Bearer {{login.response.body.$.token}}x

### Artikel mit Token (erwartet 200)
GET {{host}}/api/items/4002
Authorization: Bearer {{login.response.body.$.token}}

### Vorraete mit Token (erwartet 200)
GET {{host}}/api/stockbatches
Authorization: Bearer {{login.response.body.$.token}}

### Artikel mit Token anlegen (erwartet 201)
POST {{host}}/api/items
Content-Type: application/json
Authorization: Bearer {{loginAnna.response.body.$.token}}

{
  "name": "Taschenlampe",
  "description": ""
}
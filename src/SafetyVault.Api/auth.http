@host = https://localhost:7247

### user anlegen
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "userName": "TESTUSER",
  "userEmail": "testuser3@example.com",
  "password": "TestPassword123!"
}

### user einloggen
POST {{host}}/api/auth/login
Content-Type: application/json
{
  "login": "testuser",
  "password": "TestPassword123!"
}

<Window x:Class="SafetyVault.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SafetyVault.Wpf.Views"
        mc:Ignorable="d"
        Title="SafetyVault" Height="450" Width="1000">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid>
        <Grid Visibility="{Binding IsLoggedOut, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:LoginView DataContext="{Binding Login}"/>
        </Grid>
        <DockPanel Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Button Content="Abmelden" Command="{Binding LogoutCommand}" DockPanel.Dock="Top" HorizontalAlignment="Right" Width="100" Margin="5"/>
            <TabControl>
                <TabItem Header="Checklisten">
                    <local:ChecklistView DataContext="{Binding Checklists}"/>
                </TabItem>
                <TabItem Header="Artikel">
                    <local:ItemCatalogView DataContext="{Binding ItemCatalog}"/>
                </TabItem>
                <TabItem Header="Vorräte">
                    <local:StockView DataContext="{Binding Stock}" />
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
